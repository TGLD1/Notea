<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème de l'application après l'écran de démarrage. -->
    <style name="Theme.Notea" parent="Theme.AppCompat.Light.NoActionBar" />

    <!-- Écran de démarrage : fond blanc + emblème FASTEK. -->
    <style name="Theme.Notea.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_fond</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Notea</item>
    </style>
</resources>
