<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde automatique Android (Android 12 et plus) : toute la base de Notea, la photo, les archives
     et les réglages sont sauvegardés dans le compte Google de l'utilisateur ; seule la file technique
     des rappels (WorkManager) est exclue, elle est recréée au démarrage. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
    </device-transfer>
</data-extraction-rules>
